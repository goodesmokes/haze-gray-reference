rules_version = '2';

service cloud.firestore {
match /databases/{database}/documents {
function signedIn() {
  return request.auth != null;
}

function userDoc(uid) {
  return get(/databases/$(database)/documents/users/$(uid));
}

function currentUserExists() {
  return signedIn()
    && exists(/databases/$(database)/documents/users/$(request.auth.uid));
}

function currentRole() {
  return userDoc(request.auth.uid).data.role;
}

function currentUserActive() {
  return userDoc(request.auth.uid).data.active == true;
}

function authorized() {
  return currentUserExists()
    && currentUserActive()
    && currentRole() in ['owner', 'admin', 'field_rep', 'viewer'];
}

function isOwner() {
  return authorized()
    && currentRole() == 'owner';
}

function isManager() {
  return authorized()
    && currentRole() in ['owner', 'admin'];
}

// -------------------------------
// CIGAR CATALOG
// -------------------------------

match /cigars/{cigarId} {

  // Catalog remains publicly readable.
  allow read: if true;

  // Only active Owner/Admin users can change master cigar data,
  // pricing, sizes, or package information.
  allow create, update, delete: if isManager();
}

// -------------------------------
// AUTHORIZED USER PROFILES
// -------------------------------

match /users/{userId} {

  // Any authenticated user may read their own authorization profile.
  allow get: if signedIn()
             && request.auth.uid == userId;

  // Active Owner/Admin users may read the user list and profiles.
  allow list: if isManager();

  allow get: if isManager();

  // Owner/Admin can update existing profiles,
  // subject to field and self-protection rules below.
  allow update: if isManager()

    // Only these fields may exist after the update.
    && request.resource.data.keys().hasOnly([
      'displayName',
      'email',
      'role',
      'territory',
      'active'
    ])

    // Required profile fields must remain present.
    && request.resource.data.keys().hasAll([
      'displayName',
      'email',
      'role',
      'territory',
      'active'
    ])

    // Restrict role values.
    && request.resource.data.role in [
      'owner',
      'admin',
      'field_rep',
      'viewer'
    ]

    // Basic type checks.
    && request.resource.data.displayName is string
    && request.resource.data.email is string
    && request.resource.data.territory is string
    && request.resource.data.active is bool

    // Nobody can disable their own authorization profile.
    && (
      request.auth.uid != userId
      || request.resource.data.active == true
    )

    // Nobody can change their own role.
    && (
      request.auth.uid != userId
      || request.resource.data.role == resource.data.role
    )

    // Owners may manage other profiles, including other Owners.
    // Admins may only manage and assign non-Owner roles.
    && (
      isOwner()
      || (
        currentRole() == 'admin'
        && resource.data.role in ['admin', 'field_rep', 'viewer']
        && request.resource.data.role in ['admin', 'field_rep', 'viewer']
      )
    );

  // Authorization profile creation remains a deliberate
  // Firebase-console/admin operation for now.
  allow create: if false;

  // Do not delete authorization profiles through the app.
  allow delete: if false;
}

// -------------------------------
// LEGACY DATA
// -------------------------------

match /app-data/cigars {
  allow read: if true;
  allow write: if false;
}

// -------------------------------
// IMMUTABLE SAVED ORDERS
// -------------------------------
function canUseOrders() {
  return authorized() && currentRole() in ['owner', 'admin', 'field_rep'];
}

match /orders/{orderId} {
  // A transaction must be able to check an unused ID. This reveals no order data.
  allow get: if canUseOrders() && (!exists(/databases/$(database)/documents/orders/$(orderId))
    || isManager() || resource.data.creatorUid == request.auth.uid);
  allow list: if canUseOrders() && (isManager() || resource.data.creatorUid == request.auth.uid);
  // Internal reference snapshots: line contents/pricing are supplied by the client.
  // Validate only bounded top-level structure; never iterate all order lines here.
  allow create: if canUseOrders()
    && request.resource.data.keys().hasOnly(['retailerId', 'schemaVersion', 'status', 'retailerName', 'retailerNameNormalized', 'retailerEmail', 'notes', 'creatorUid', 'creatorDisplayName', 'savedAt', 'lineItems', 'totals'])
    && request.resource.data.keys().hasAll(['schemaVersion', 'status', 'retailerName', 'retailerNameNormalized', 'retailerEmail', 'notes', 'creatorUid', 'creatorDisplayName', 'savedAt', 'lineItems', 'totals'])
    && request.resource.data.creatorUid == request.auth.uid
    && (!('retailerId' in request.resource.data) || (request.resource.data.retailerId is string && request.resource.data.retailerId.size() > 0 && request.resource.data.retailerId.size() <= 128 && !request.resource.data.retailerId.matches('.*[/].*')))
    && request.resource.data.creatorDisplayName is string && request.resource.data.creatorDisplayName.size() <= 500
    && request.resource.data.creatorDisplayName == userDoc(request.auth.uid).data.displayName
    && request.resource.data.schemaVersion is int && request.resource.data.schemaVersion == 1
    && request.resource.data.status == 'saved'
    && request.resource.data.savedAt is timestamp && request.resource.data.savedAt == request.time
    && request.resource.data.retailerName is string && request.resource.data.retailerName.size() <= 500
    && request.resource.data.retailerNameNormalized is string && request.resource.data.retailerNameNormalized.size() <= 1500
    && request.resource.data.retailerEmail is string && request.resource.data.retailerEmail.size() <= 500
    && request.resource.data.notes is string && request.resource.data.notes.size() <= 10000
    && request.resource.data.lineItems is list && request.resource.data.lineItems.size() > 0 && request.resource.data.lineItems.size() <= 100
    && request.resource.data.totals is map
    && request.resource.data.totals.keys().hasOnly(['wholesaleTotal', 'retailTotal', 'grossProfit', 'marginPct', 'totalQuantity', 'lineCount'])
    && request.resource.data.totals.wholesaleTotal is number && request.resource.data.totals.wholesaleTotal >= 0 && request.resource.data.totals.wholesaleTotal <= 1000000000
    && request.resource.data.totals.retailTotal is number && request.resource.data.totals.retailTotal >= 0 && request.resource.data.totals.retailTotal <= 1000000000
    && request.resource.data.totals.grossProfit is number && request.resource.data.totals.grossProfit >= -1000000000 && request.resource.data.totals.grossProfit <= 1000000000
    && request.resource.data.totals.marginPct is number && request.resource.data.totals.marginPct <= 100 && request.resource.data.totals.marginPct >= -1000000000000000
    && request.resource.data.totals.totalQuantity is int && request.resource.data.totals.totalQuantity > 0 && request.resource.data.totals.totalQuantity <= 100000000
    && request.resource.data.totals.lineCount is int && request.resource.data.totals.lineCount == request.resource.data.lineItems.size();
  allow update, delete: if false;
}

// -------------------------------
// SHARED RETAILER DIRECTORY
// -------------------------------
function validRetailer(data) {
  return data.keys().hasOnly(['schemaVersion', 'active', 'name', 'contactName', 'email', 'phone', 'address1', 'address2', 'city', 'state', 'postalCode', 'country', 'website', 'notes', 'nameNormalized', 'creatorUid', 'creatorDisplayName', 'createdAt', 'updatedAt'])
    && data.keys().hasAll(['schemaVersion', 'active', 'name', 'contactName', 'email', 'phone', 'address1', 'address2', 'city', 'state', 'postalCode', 'country', 'website', 'notes', 'nameNormalized', 'creatorUid', 'creatorDisplayName', 'createdAt', 'updatedAt'])
    && data.schemaVersion is int && data.schemaVersion == 1
    && data.active is bool
    && data.name is string && data.name.size() <= 500
    && data.contactName is string && data.contactName.size() <= 500
    && data.email is string && data.email.size() <= 500
    && data.phone is string && data.phone.size() <= 500
    && data.address1 is string && data.address1.size() <= 500
    && data.address2 is string && data.address2.size() <= 500
    && data.city is string && data.city.size() <= 500
    && data.state is string && data.state.size() <= 500
    && data.postalCode is string && data.postalCode.size() <= 500
    && data.country is string && data.country.size() <= 500
    && data.website is string && data.website.size() <= 500
    && data.notes is string && data.notes.size() <= 5000
    && data.name.size() > 0 && data.name.matches('.*[^ ].*')
    && data.nameNormalized is string && data.nameNormalized.size() > 0 && data.nameNormalized.size() <= 1500
    && data.creatorUid is string && data.creatorUid.size() > 0 && data.creatorUid.size() <= 128
    && data.creatorDisplayName is string && data.creatorDisplayName.size() <= 500
    && data.createdAt is timestamp && data.updatedAt is timestamp;
}
match /retailers/{retailerId} {
  allow read: if canUseOrders() && (isManager() || resource.data.active == true);
  allow create: if canUseOrders() && validRetailer(request.resource.data)
    && request.resource.data.active == true
    && request.resource.data.creatorUid == request.auth.uid
    && request.resource.data.creatorDisplayName == userDoc(request.auth.uid).data.displayName
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;
  allow update: if canUseOrders() && validRetailer(request.resource.data)
    && (isManager() || (resource.data.active == true && request.resource.data.active == resource.data.active))
    && request.resource.data.creatorUid == resource.data.creatorUid
    && request.resource.data.creatorDisplayName == resource.data.creatorDisplayName
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.schemaVersion == resource.data.schemaVersion
    && request.resource.data.updatedAt == request.time;
  allow delete: if false;
}

// Everything else denied.
match /{document=**} {
  allow read, write: if false;
}

}
}
